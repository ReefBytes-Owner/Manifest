# Agent Output Directory (runtime files, logs, temp outputs)
.claude/.agent_outputs/
configs/claude/.agent_outputs/

# XDG runtime state when XDG_STATE_HOME points at the repository root.
/manifest/

# Former Copilot target, generated by the retired `retired skill supply sync`
# (removed 2026-07-27, FR-021a). Nothing writes this today; the entry stays so
# a stale local copy cannot be committed by accident.
.github/skills/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/

# Virtual environments
venv/
env/
ENV/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node (bats test runner installed via npm in CI / locally)
node_modules/
package-lock.json
# The toolchain store's node-env source is a reviewed lockfile, not a build artifact (C7g).
!config/toolchain/package-lock.json

# local tool side-effect, origin unknown (not SkillClaw — see specs/003 research R10)
records/

# Logs
*.log

# Temp files
*.tmp
.tmp-*
.tmp-*/

# spec-review runtime (feedback, content-hash, lock, error log)
.spec-review/

# skill-creator eval workspaces (iteration outputs, benchmarks, rework runs)
*-workspace/
# ...but NOT the plugin bundle of that name. This pattern silently swallowed
# plugins/manifest-workspace/.claude-plugin/, so a fresh clone got the bundle's
# 17 skills with no manifest and the partition gate counted 97 of 114. The
# skills themselves were already tracked when the rule landed, which is why
# nothing went red locally -- only a clean checkout could see it.
!plugins/manifest-workspace/

# spec 362: user-local guidance overrides are machine-local (created lazily on
# first opt-out under ~/.claude/config/) — never commit them. The shipped
# defaults live in configs/claude/config/guidance.yml (tracked).
guidance_local.yml

# Transient smoke-test JUnit output (smoke_test.py default --junit)
smoke-report.xml
report.xml
# Transient per-catalog write lock (smoke_test.py append)
smoke-catalog/*.lock

# Root coordinator and home-runtime lockfiles are committed.
!uv.lock
!configs/claude/uv.lock
benchmark_data/
.claude/settings.local.json

# .apm/skills is GENERATED from plugins/*/skills/* by
# configs/claude/scripts/generate_skill_mirror.sh (T3.3, spec 674).
# The source of truth is plugins/<bundle>/skills/<name>/. The mirror keeps the
# flat view that 87 references across 35 files still read, so moving the source
# required no retargeting. Real files, never symlinks -- both copy paths in
# bootstrap/lib/common.sh preserve symlinks-as-symlinks, which would deploy 108
# dangling links while every repo-side gate stayed green.
.apm/skills/
